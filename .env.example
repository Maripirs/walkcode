# Walkcode local environment — TEMPLATE (safe to commit; contains no secrets).
#
# To enable M9 AI algorithm coaching locally:
#   1. cp .env.example .env
#   2. open .env in your editor and paste your key after NVIDIA_API_KEY=
#      (do NOT paste it into chat, and do NOT echo it on a command line)
#   3. docker compose up   →  the guided coach appears on the Algorithm step
#
# .env is gitignored, so your real key never gets committed. Leaving NVIDIA_API_KEY empty
# keeps the feature off — the Algorithm step still works via the deterministic drag-and-drop builder.

# The provider auto-selects from whichever key you set below (Groq preferred). Set ONE.
#   GROQ_API_KEY   from console.groq.com — uses Groq's fast, free Llama-70B (recommended; much
#                  better coaching than 8B; free tier is 12k tokens/min, plenty for one user).
#   NVIDIA_API_KEY from build.nvidia.com (nvapi-...) — falls back to NVIDIA NIM 8B if no Groq key.
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional overrides (leave blank to use the per-provider defaults in server/llm.js):
#   LLM_MODEL     default: llama-3.3-70b-versatile (Groq) / meta/llama-3.1-8b-instruct (NVIDIA).
#                 Changing env here needs `docker compose up -d` (recreate); `restart` won't re-read .env.
#   LLM_BASE_URL  default: Groq or NVIDIA endpoint per the key.
LLM_MODEL=
LLM_BASE_URL=
